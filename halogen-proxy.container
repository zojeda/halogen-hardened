[Unit]
Description=TCP proxy to halogen (the only part with an external network)

[Container]
Image=docker.io/alpine/socat@sha256:603174b77eebaba25ba8f8ebb15e1234d6600409554e95d6fb203fd106150287
ContainerName=halogen-proxy
Network=halogen-int.network
Network=halogen-ext.network
# Localhost only. For other machines: <your LAN IP>:8731:8731
PublishPort=127.0.0.1:8731:8731
Exec=TCP-LISTEN:8731,fork,reuseaddr TCP:halogen-backend:8731
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
PidsLimit=256
PodmanArgs=--memory=128m

[Service]
Restart=always
